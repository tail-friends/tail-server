# 복사해서 사용: cp .env.example .env  (.env는 커밋하지 않음)

# Spring 프로필 (local / dev / prod)
SPRING_PROFILES_ACTIVE=local

# docker-compose PostgreSQL
POSTGRES_DB=tailfriends
POSTGRES_USER=tailfriends
POSTGRES_PASSWORD=change-me

# 애플리케이션 DB 접속
DB_URL=jdbc:postgresql://localhost:5432/tailfriends
DB_USERNAME=tailfriends
DB_PASSWORD=change-me

# JWT (secret은 최소 32바이트 이상, 예: openssl rand -base64 64)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d

# 소셜 로그인 (카카오 디벨로퍼스 REST API 키·Client Secret, 구글 클라우드 OAuth 클라이언트 ID·보안 비밀)
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 애플 (iOS 앱 번들 ID, 팀 ID, Sign in with Apple 키 ID, 그 키의 .p8 내용을 한 줄로: 줄바꿈은 \n 또는 BEGIN/END 줄을 뺀 Base64)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# 사진 저장소 (서버 디스크 경로, 사진 주소 앞부분, 사용자당 하루 업로드 수)
STORAGE_LOCAL_PATH=./storage
STORAGE_PUBLIC_URL=http://localhost:8080/files
STORAGE_DAILY_UPLOAD_LIMIT=30

# CORS 허용 origin (쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# AI (Google AI Studio에서 받은 Gemini API 키, 모델, 사용자당 하루 분석 횟수)
AI_MODEL=gemini-2.5-flash
AI_DAILY_LIMIT=5
AI_API_KEY=

# 로컬 테스트 로그인 (POST /api/v1/dev/login). 운영에서는 넣지 않는다 (prod 프로필에서 true면 서버가 뜨지 않음)
DEV_LOGIN_ENABLED=false
