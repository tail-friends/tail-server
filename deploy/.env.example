# 서버의 배포 폴더에 .env로 복사해서 사용한다. (.env는 커밋하지 않음)

# Spring 프로필 (개발 서버: dev, 운영 서버: prod)
SPRING_PROFILES_ACTIVE=dev

# 외부에 노출할 앱 포트
APP_PORT=8080

# PostgreSQL (DB_URL은 docker-compose가 자동으로 설정)
POSTGRES_DB=tailfriends
POSTGRES_USER=tailfriends
POSTGRES_PASSWORD=change-me
DB_USERNAME=tailfriends
DB_PASSWORD=change-me

# JWT (secret은 최소 32바이트 이상, 예: openssl rand -base64 64)
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
JWT_ACCESS_TOKEN_EXPIRATION=30m
JWT_REFRESH_TOKEN_EXPIRATION=14d

# CORS 허용 origin (쉼표로 구분)
CORS_ALLOWED_ORIGINS=http://localhost:3000

# AI
AI_API_KEY=
